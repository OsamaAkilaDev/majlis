DATABASE_URL="postgresql://majlis:majlis@localhost:5432/majlis_dev?schema=public"

SESSION_SECRET="dev-only-session-secret-change-me!!"

# Project Settings -> API, and Project Settings -> API Keys -> secret.
# Bucket majlis-storage. The name is a constant in code, not a variable.
SUPABASE_STORAGE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /internal/lifecycle-sweep. Defaults to the example
# value in development; production refuses to boot with it.
LIFECYCLE_SWEEP_SECRET="dev-only-lifecycle-sweep-secret"

LOG_LEVEL=debug
