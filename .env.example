NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Pooled connection used by the application at runtime.
# In production this is Supabase's transaction pooler on :6543 with
# ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://majlis:majlis@localhost:5432/majlis_dev?schema=public"

# Direct connection used by prisma migrate. In production, Supabase :5432.
DIRECT_URL="postgresql://majlis:majlis@localhost:5432/majlis_dev?schema=public"

# Dedicated database for integration tests. Truncated between tests.
TEST_DATABASE_URL="postgresql://majlis:majlis@localhost:5432/majlis_test?schema=public"

# Ephemeral database `prisma migrate diff`/`migrate dev` create and drop
# around the DIRECT_URL database to diff the migrations history against it.
# The `majlis` role needs CREATEDB for this.
SHADOW_DATABASE_URL="postgresql://majlis:majlis@localhost:5432/majlis_shadow?schema=public"

# Signs the 15-minute access token. Minimum 32 characters.
# Production MUST override this — the app refuses to boot with it.
SESSION_SECRET="dev-only-session-secret-change-me!!"

# Access token lifetime. The window in which a revoked session still works.
ACCESS_TOKEN_TTL="15m"

# Refresh token lifetime. Rotation issues a fresh one each time (sliding).
REFRESH_TOKEN_TTL="30d"
