DATABASE_URL="postgresql://majlis:majlis@localhost:5432/majlis_dev?schema=public"

SESSION_SECRET="dev-only-session-secret-change-me!!"

# Project Settings -> API, and Project Settings -> API Keys -> secret.
# Bucket majlis-storage. The name is a constant in code, not a variable.
SUPABASE_STORAGE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /internal/lifecycle-sweep. Defaults to the example
# value in development; production refuses to boot with it.
LIFECYCLE_SWEEP_SECRET="dev-only-lifecycle-sweep-secret"

# Signs every QR pass. Defaults to the example value in development;
# production refuses to boot with it. Minimum 32 characters.
QR_SIGNING_SECRET="dev-only-qr-signing-secret-change-me!!"

# Hours after an event ends during which Operations and Lead may correct
# attendance. Also gates issuance: certificates go out once it closes.
ATTENDANCE_CORRECTION_WINDOW_HOURS=48

# Where the QR printed on a certificate points, for /verify/{code}.
PUBLIC_WEB_ORIGIN="http://localhost:3000"

LOG_LEVEL=debug
